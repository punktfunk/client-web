@punktfunk:registry=https://git.unom.io/api/packages/unom/npm/
@unom:registry=https://git.unom.io/api/packages/unom/npm/
; @unom/ui 0.10 lists its CMS editor (@payloadcms/richtext-lexical) as a required peer, and
; @unom/style 0.4.4 still wants motion ^12. Without this npm installs ~300 packages this app never
; imports, then refuses the motion range. Drop it once both declare those peers optional or current.
legacy-peer-deps=true
