{
  "name": "punktfunk-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "The punktfunk web client — the flagship consumer of @punktfunk/stream. React + @unom/ui + Tailwind, the same stack as the host's management console.",
  "scripts": {
    "l10n": "node ../../scripts/l10n-messages.mjs && paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy preferredLanguage baseLocale",
    "predev": "npm run l10n",
    "dev": "vite",
    "prebuild": "npm run l10n",
    "build": "vite build",
    "precheck": "npm run l10n",
    "check": "tsc --noEmit",
    "pretest": "npm run l10n",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test 'src/**/*.test.ts'",
    "prestorybook": "npm run l10n",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "npm run l10n",
    "build-storybook": "storybook build",
    "screenshots": "node tools/screenshots.mjs",
    "cjk-e2e": "node tools/cjk-e2e.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@punktfunk/stream": "*",
    "@unom/style": "^0.4.4",
    "@unom/ui": "^0.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1",
    "motion": "^13.4.4",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@fontsource/noto-sans-kr": "^5.3.1",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@fontsource/noto-sans-tc": "^5.3.1",
    "@inlang/paraglide-js": "^2.29.3",
    "@inlang/plugin-message-format": "^4.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6",
    "playwright": "^1.63.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
