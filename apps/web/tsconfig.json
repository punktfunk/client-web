{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    // `vite/client` declares the CSS imports, which TypeScript 7 checks like any other import.
    "types": ["@webgpu/types", "node", "vite/client"],
    "paths": {
      // The library from source, not from its `dist/`: this is the workspace's own consumer, and
      // resolving the sources is what makes a change in the engine show up here without a build
      // in between. External consumers get the packed `dist/`, and the tarball gate proves that.
      "@punktfunk/stream": ["../../packages/stream/src/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", ".storybook/**/*.ts", ".storybook/**/*.tsx"]
}
